<idea-plugin>
    <id>dev.jiraissuetracker</id>
    <name>Jira Issue Tracker</name>
    <vendor>Jira Issue Tracker</vendor>
    <description>Browse Jira issues, track and log work, change status, and discuss issues using an independent Jira connection.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>


    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="dev.jiraissuetracker.intellij.JiraSettings"/>
        <applicationConfigurable id="dev.jiraissuetracker.settings" parentId="tools"
                                 instance="dev.jiraissuetracker.intellij.JiraSettingsConfigurable"
                                 bundle="src" key="settings.title"/>
        <toolWindow id="Jira Issues"
                    anchor="right"
                    factoryClass="dev.jiraissuetracker.intellij.JiraIssuesToolWindowFactory"
                    icon="/icons/appIcon.svg"
        />
    </extensions>
</idea-plugin>
